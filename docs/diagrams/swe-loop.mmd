graph TB
    Start(["👤 Dejan"])
    P0["Design
    ADR + options"]
    GateA{"Gate A
    approve?"}
    P1["Plan
    tasks + budget"]
    P2["Context
    reuse check"]
    P3["Implement
    one task/commit"]
    P4["Test
    plan first"]
    P5["Review
    fresh context"]
    P6["Verify
    vs ADR"]
    GateB{"Gate B
    approve?"}
    Done["Closed
    memory updated"]

    Start -->|"① design"| P0
    P0 --> GateA
    GateA -->|"② approved"| P1
    GateA -.->|"amend"| P0
    P1 -->|"③ plan"| P2
    P2 -->|"④ context"| P3
    P3 -->|"⑤ implement"| P4
    P4 -->|"⑥ test"| P5
    P5 -->|"⑦ review"| P6
    P6 -->|"⑧ verify"| GateB
    GateB -->|"⑨ approved"| Done
    GateB -.->|"fix"| P3

    class GateA decision
    class GateB decision
    class Done success

    classDef success   fill:#d3f9d8,stroke:#2f9e44,color:#1a3620
    classDef transport fill:#d0ebff,stroke:#1971c2,color:#0b3866
    classDef protocol  fill:#fff3bf,stroke:#e8a400,color:#5c4500
    classDef blocked   fill:#ffe3e3,stroke:#e03131,color:#5c1a1a
    classDef decision  fill:#e5dbff,stroke:#7048e8,color:#2c1a5c
