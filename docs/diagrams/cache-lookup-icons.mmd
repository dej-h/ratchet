graph LR
    User@{ shape: icon, icon: "mdi:account", label: "Browser", pos: "t" }

    subgraph lookup["Cache Lookup"]
        Cache@{ shape: icon, icon: "mdi:cached", label: "Cache", pos: "t", form: "rounded" }
        DNS@{ shape: icon, icon: "mdi:web", label: "DNS", pos: "t", form: "rounded" }
    end

    Server@{ shape: icon, icon: "mdi:server", label: "Server", pos: "t" }
    Page@{ shape: icon, icon: "mdi:check-circle", label: "Loaded", pos: "t" }

    User -->|"① request"| Cache
    Cache -->|"② miss"| DNS
    DNS -->|"③ resolve"| Server
    Server -->|"④ respond"| Page

    class Cache decision
    class Page success

    classDef success   fill:#d3f9d8,stroke:#2f9e44,color:#1a3620
    classDef transport fill:#d0ebff,stroke:#1971c2,color:#0b3866
    classDef protocol  fill:#fff3bf,stroke:#e8a400,color:#5c4500
    classDef blocked   fill:#ffe3e3,stroke:#e03131,color:#5c1a1a
    classDef decision  fill:#e5dbff,stroke:#7048e8,color:#2c1a5c

    style lookup fill:#f4f1e8,stroke:#4a4438,stroke-width:3px
